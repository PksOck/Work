# Delovni pult: nastavitve za cPanel (Apache)
# Aplikacija je ena statična stran. Strežnik ne prejme nobenih podatkov.

# Samo HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Brez seznama datotek
Options -Indexes

<IfModule mod_headers.c>
  # Stran ne nalaga ničesar z drugih strežnikov in ne pošilja podatkov drugam.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Robots-Tag "noindex, nofollow"
  # Vedno najnovejša različica strani
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Zaščita z geslom: najlažje v cPanel → "Directory Privacy" (Zasebnost map)
# za to mapo. cPanel sam doda AuthType/AuthUserFile vrstice sem ali v nadrejeno mapo.
